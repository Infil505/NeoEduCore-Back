<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <!--
            Fuera del cálculo de cobertura: herramientas de desarrollo que solo se
            ejecutan desde consola y nunca atienden a un usuario (generadores de
            OpenAPI, Postman y diagramas, y el volcado y chequeo del esquema).
            ApiSpec solo alimenta a esos generadores. La lógica de comparación de
            schema:check-drift sí cuenta: vive en app/Support/SchemaDrift.php.
        -->
        <exclude>
            <directory>app/Console</directory>
            <file>app/Support/ApiSpec.php</file>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Sin red en los tests: los que prueban la comprobación la activan y simulan Http. -->
        <env name="AI_LINK_CHECK" value="false"/>
        <!-- La suite lanza cientos de peticiones desde la misma IP: el limite
             general se sube para que no se bloquee a si misma. Los limites
             especificos (login, ai-global) se dejan reales, que son los que
             tienen tests propios. -->
        <env name="RATE_LIMIT_API_PER_MINUTE" value="100000"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <!-- Aislada de la base de desarrollo (.env usa "neoeducore"): esto
             evita que correr la suite recargue el esquema y borre los datos
             de desarrollo. Coincide con DB_DATABASE en .env.testing. -->
        <env name="DB_DATABASE" value="neoeducoretest"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
