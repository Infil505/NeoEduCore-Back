APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=neoeducore
DB_USERNAME=root
DB_PASSWORD=

# Opcional (solo dev): ruta a pg_dump para regenerar el SQL de esquema de tests
# con `php artisan schema:dump-sql`. Ej. Windows:
# PG_DUMP_PATH="C:/Program Files/PostgreSQL/17/bin/pg_dump.exe"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Expiración de tokens Sanctum en minutos (por defecto 12 h). Un token filtrado
# deja de ser válido pasado este tiempo. Programar `sanctum:prune-expired` para
# limpiar la tabla. Dejar vacío/quitar la línea = tokens sin expiración.
SANCTUM_TOKEN_EXPIRATION_MINUTES=720

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# NO usar `array` fuera de tests: con Octane cada worker tendría su propia
# memoria, así que los rate limiters (incluido el presupuesto global de IA)
# dejarían de ser globales y el contexto cacheado del tutor no se compartiría.
# `file` basta para un contenedor; con varios, usar `redis`.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenAI
# OPENAI_REQUEST_TIMEOUT acota cuánto tiempo un worker de Octane queda
# bloqueado esperando a OpenAI sin poder atender nada más. El default de la
# librería son 30 s: demasiado. Ver ANALISIS_CONCURRENCIA.md §5.3.
OPENAI_API_KEY=
OPENAI_REQUEST_TIMEOUT=15

# Swagger / L5-Swagger
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_BASE_PATH=/api
L5_SWAGGER_CONST_HOST=http://localhost:8000
