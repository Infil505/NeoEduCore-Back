# ============================================================================
# INSTANCIA 3 — WORKER (cola)  ·  recurso Coolify "Worker"
# Comando: lo fija CONTAINER_ROLE=worker
#   (queue:work --queue=default,correos --tries=3 --max-time=3600 --max-jobs=500 --memory=128)
# Sin dominio ni puertos. Pre/Post-deployment: VACÍOS.
# Manda correos, procesa la carga masiva y PUBLICA los eventos hacia el WebSocket.
# ============================================================================
CONTAINER_ROLE=worker
# El Worker lanza el scheduler (abre/cierra exámenes, entrega intentos vencidos). true en UN solo Worker.
RUN_SCHEDULER=true

APP_NAME=NeoEduCore
APP_ENV=production
APP_DEBUG=false
# IGUAL que en App y WebSocket
APP_KEY=
# los enlaces de los correos se arman con esto
APP_URL=https://neoeducore.api.eduregistro.com
APP_LOCALE=es
# Espera tras el plazo antes de entregar solo un intento no enviado. IGUAL en App y Worker (junto con EXAM_*).
EXAM_AUTO_SUBMIT_DELAY_SECONDS=120
EXAM_ADECUACION_EVALUACION=1.50
EXAM_ADECUACION_ACCESO=1.25
EXAM_MAX_PAUSE_SECONDS=900
EXAM_GRACE_SECONDS=30
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Base de datos (misma que la App) ----------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-us-west-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.xxxxxxxx
DB_PASSWORD=
DB_STATEMENT_TIMEOUT_MS=15000

# --- Cola y caché (la caché la comparte con la App: redis) -------------------
QUEUE_CONNECTION=database
CACHE_STORE=redis
SESSION_DRIVER=database
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Correo ------------------------------------------------------------------
MAIL_MAILER=resend
# API key de Resend (dominio verificado). SMTP no sirve: DigitalOcean bloquea 25/465/587.
RESEND_KEY=
MAIL_FROM_ADDRESS=no-reply@neoeducore.eduregistro.com
MAIL_TIMEOUT=15
MAIL_FROM_NAME="${APP_NAME}"

# --- WebSocket: el Worker publica el evento «examen activado» ----------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=neoeducore
# IGUAL que en App y WebSocket
REVERB_APP_KEY=
# IGUAL que en App y WebSocket
REVERB_APP_SECRET=
REVERB_HOST=ws.neoeducore.eduregistro.com
REVERB_PORT=443
REVERB_SCHEME=https
# nombre interno del recurso WebSocket en Coolify
REVERB_PUBLISH_HOST=
REVERB_PUBLISH_PORT=8180
REVERB_PUBLISH_SCHEME=http
FRONTEND_URL=https://neoeducore.eduregistro.com

# --- IA (trabajos en cola que llaman a OpenAI) --------------------------------
OPENAI_API_KEY=
OPENAI_REQUEST_TIMEOUT=15
OPENAI_MODEL=gpt-4o-mini

# --- Carga masiva y dominio académico (el worker valida el archivo) ----------
BULK_MAX_ROWS=5000
BULK_MAX_MB=5
BULK_INSERT_BATCH_SIZE=500
ACADEMIC_GRADE_MIN=1
ACADEMIC_GRADE_MAX=6
ACADEMIC_SECTIONS=A,B,C,D
# las cuentas nuevas se crean en el worker
BCRYPT_ROUNDS=10
