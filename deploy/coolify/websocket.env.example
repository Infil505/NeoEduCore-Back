# ============================================================================
# INSTANCIA 2 — WEBSOCKET (Laravel Reverb)  ·  recurso Coolify "Revert/WebSocket"
# Comando: lo fija CONTAINER_ROLE=websocket (reverb:start, puerto 8180).
# Ports Exposes: 8180 · Dominio: https://ws.tu-dominio.com:8180
# Pre/Post-deployment: VACÍOS. Custom Docker options: vacío.
# No toca la base de datos: la autenticación de canales la hace la App.
# ============================================================================
CONTAINER_ROLE=websocket

APP_NAME=NeoEduCore
APP_ENV=production
APP_DEBUG=false
# IGUAL que en App y Worker
APP_KEY=
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Sin base de datos ni Redis: que Laravel no abra conexiones que no usa.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=neoeducore
# IGUAL que en App y Worker
REVERB_APP_KEY=
# IGUAL que en App y Worker
REVERB_APP_SECRET=
REVERB_HOST=ws.tu-dominio.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8180
# Reverb solo acepta conexiones de estos orígenes (separados por coma):
FRONTEND_URL=https://tu-frontend.com
# Tope de conexiones simultáneas (vacío = sin tope). Útil para proteger el droplet:
# REVERB_APP_MAX_CONNECTIONS=500
